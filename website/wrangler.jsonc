{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ptk-timetable",
  "main": "src/index.js",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/download*", "/admin*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ptk-release-metadata",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ]
}
